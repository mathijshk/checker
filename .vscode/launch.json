{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: Run Web App",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1"
      },
      "args": [
        "run",
        "--host=0.0.0.0",
        "--port=5000",
        "--no-debugger",
        "--no-reload"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Test Web App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_webapp.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: CLI Demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demo.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
