      "@app.route('/${1:path}', methods=['${2:GET}'])",
      "def ${3:function_name}():",
      "\t\"\"\"${4:Description}\"\"\"",
      "\t$0",
      "\treturn render_template('${5:template.html}')"
    ],
    "description": "Create a Flask route"
  },
  "Flask API Route": {
    "prefix": "fapi",
    "body": [
      "@app.route('/api/${1:endpoint}', methods=['${2:POST}'])",
      "def ${3:function_name}():",
      "\t\"\"\"${4:Description}\"\"\"",
      "\ttry:",
      "\t\tdata = request.get_json()",
      "\t\t$0",
      "\t\treturn jsonify({'success': True})",
      "\texcept Exception as e:",
      "\t\treturn jsonify({'error': str(e)}), 500"
    ],
    "description": "Create a Flask API route"
  },
